[Unit]
Description=WAVER Flask API
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/cimi/waver/api
ExecStart=/home/cimi/waver-env/bin/gunicorn --worker-class geventwebsocket.gunicorn.workers.GeventWebSocketWorker --workers 1 --bind 127.0.0.1:5000 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
