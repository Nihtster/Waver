{
    // Waver fastfetch config — Pi Zero 2W
    // Apply with: fastfetch --config ~/waver/config/fastfetch/config.jsonc
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "source": "~/waver/config/fastfetch/waver-logo.txt",
        "type": "file",
        "color": {
            "1": "cyan",
            "2": "blue"
        },
        "padding": {
            "top": 1,
            "left": 1
        }
    },

    "display": {
        "separator": "  →  ",
        "color": {
            "keys": "cyan",
            "title": "cyan"
        }
    },

    "modules": [
        {
            "type": "title",
            "color": {
                "user": "cyan",
                "at": "blue",
                "host": "cyan"
            }
        },
        "separator",
        {
            "type": "os",
            "key": "OS"
        },
        {
            "type": "kernel",
            "key": "Kernel"
        },
        {
            "type": "uptime",
            "key": "Uptime"
        },
        {
            "type": "cpu",
            "key": "CPU",
            "showPeCoreCount": false
        },
        {
            "type": "memory",
            "key": "Memory"
        },
        {
            "type": "disk",
            "key": "Disk",
            "folders": "/"
        },
        {
            "type": "localip",
            "key": "IP",
            "showIpv4": true,
            "showIpv6": false,
            "showLoop": false
        },
        {
            "type": "wifi",
            "key": "WiFi"
        },
        {
            "type": "temperature",
            "key": "Temp"
        },
        "separator",
        "colors"
    ]
}
